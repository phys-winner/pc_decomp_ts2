* text=auto
*.py text eol=lf
*.sh text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.inc text eol=lf
*.comp text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
