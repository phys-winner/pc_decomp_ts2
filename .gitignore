# Publication allowlist: original game files and local working data stay private.
/*
!/.gitignore
!/.gitattributes
!/readme.md
!/THIRD_PARTY_NOTICES.md
!/dependencies.json
!/requirements.txt
!/port.example.json

!/android/
/android/**
!/android/**/
!/android/**/*.c
!/android/**/*.cpp
!/android/**/*.h
!/android/**/*.inc
!/android/**/*.comp
!/android/render/shaders/*.vert
!/android/render/shaders/*.frag
!/android/**/*.java
!/android/**/*.xml
!/android/**/*.json
!/android/**/*.py
!/android/**/*.md
!/android/**/*.png
!/android/**/*.webp

!/config/
/config/*
!/config/*.json
/config/Sims2EP9.functions.json

!/tools/
/tools/**
!/tools/**/
!/tools/**/*.py
!/tools/**/*.c
!/tools/**/*.h
!/tools/**/*.cpp
!/tools/**/*.json
!/tools/*.sh

!/research/
/research/*
!/research/ida/
/research/ida/*
!/research/ida/*.json

!/.gitmodules
!/patches/
!/reference/
/reference/*
!/reference/pcrecomp
!/reference/mojoshader
!/reference/astcenc
!/reference/etcpak
!/reference/dlmalloc

# Defense in depth, also covering vendored sources.
**/.git/
**/__pycache__/
**/build/
**/.idea/
**/.vscode/
*.py[cod]
*.apk
*.aab
*.exe
*.dll
*.so
*.o
*.obj
*.a
*.lib
*.pdb
*.class
*.dex
*.zip
*.7z
*.tar.gz
*.package
*.sav
