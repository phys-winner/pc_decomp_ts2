#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D scene_depth;
layout(binding=1) uniform isampler2D optical_flow;
layout(binding=2) uniform sampler2D final_color;
layout(binding=3) uniform sampler2D opaque_color;
layout(binding=4,r32f) writeonly uniform image2D output_depth;
layout(binding=5,rg16f) writeonly uniform image2D output_motion;
layout(binding=6,r8) writeonly uniform image2D output_reactive;
layout(binding=7,rgba16f) uniform image2D upscaled_color;
layout(push_constant) uniform phase_t { uint composite; };

ivec2 block(ivec2 p) { return clamp(p,ivec2(0),textureSize(optical_flow,0)-1); }
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=composite!=0?imageSize(upscaled_color):imageSize(output_depth);
    if(any(greaterThanEqual(p,size)))return;
    vec2 uv=(vec2(p)+.5)/vec2(size);
    if(composite!=0){
        ivec2 inputSize=textureSize(final_color,0);
        vec2 position=uv*vec2(inputSize)-.5,weight=fract(position);
        ivec2 base=ivec2(floor(position));
        vec3 color=vec3(0);
        bool overlay=false;
        for(int y=0;y<2;++y)for(int x=0;x<2;++x){
            ivec2 q=clamp(base+ivec2(x,y),ivec2(0),inputSize-1);
            vec3 final=texelFetch(final_color,q,0).rgb,opaque=texelFetch(opaque_color,q,0).rgb;
            overlay=overlay||any(greaterThan(abs(final-opaque),vec3(.5/255.0)));
            color+=final*(x==0?1-weight.x:weight.x)*(y==0?1-weight.y:weight.y);
        }
        // shortcut: the game exposes no separate UI alpha, so changed pixels keep the spatial composite; use alpha when available.
        if(overlay)imageStore(upscaled_color,p,vec4(color,1));
        return;
    }
    ivec2 depthPixel=clamp(ivec2(uv*textureSize(scene_depth,0)),ivec2(0),textureSize(scene_depth,0)-1);
    vec2 flowPos=(vec2(p)+.5)/8.0-.5,weight=fract(flowPos);
    ivec2 base=ivec2(floor(flowPos));
    vec2 motion=mix(mix(vec2(texelFetch(optical_flow,block(base),0).xy),vec2(texelFetch(optical_flow,block(base+ivec2(1,0)),0).xy),weight.x),
                    mix(vec2(texelFetch(optical_flow,block(base+ivec2(0,1)),0).xy),vec2(texelFetch(optical_flow,block(base+ivec2(1,1)),0).xy),weight.x),weight.y);
    uvec4 packed=uvec4(round(texelFetch(scene_depth,depthPixel,0)*255.0));
    imageStore(output_depth,p,vec4(uintBitsToFloat(packed.x | (packed.y<<8u) | (packed.z<<16u) | (packed.w<<24u))));
    imageStore(output_motion,p,vec4(motion,0,0));
    imageStore(output_reactive,p,vec4(0));
}
