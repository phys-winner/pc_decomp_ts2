        },
        {
          "value": "100",
          "title": "100%"
        }
      ]
    },
    {
      "key": "frame_rate_limit",
      "type": "choice",
      "title": {
        "en": "Frame rate limit",
        "ru": "Ограничение частоты кадров"
      },
      "default": "game",
      "choices": [
        {
          "value": "game",
          "title": {
            "en": "Use game setting",
            "ru": "Из настроек игры"
          }
        },
        {
          "value": "0",
          "title": {
            "en": "Unlimited",
            "ru": "Без ограничения"
          }
        },
        {
          "value": "30",
          "title": "30 FPS"
        },
        {
          "value": "60",
          "title": "60 FPS"
        },
        {
          "value": "90",
          "title": "90 FPS"
        },
        {
          "value": "120",
          "title": "120 FPS"
        }
      ]
    },
    {
      "key": "ui_fsr",
      "type": "choice",
      "title": {
        "en": "FSR 1 for interface textures",
        "ru": "FSR 1 для текстур интерфейса"
      },
      "default": "0",
      "choices": [
        {
          "value": "0",
          "title": {
            "en": "Off",
            "ru": "Выключено"
          }
        },
        {
          "value": "1",
          "title": {
            "en": "On",
            "ru": "Включено"
          }
        }
      ]
    },
    {
      "key": "render_aa",
      "type": "choice",
      "title": {
        "en": "Render antialiasing",
        "ru": "Сглаживание рендера"
      },
      "default": "0",
      "choices": [
        {
          "value": "0",
          "title": {
            "en": "Off",
            "ru": "Выключено"
          }
        },
        {
          "value": "1",
          "title": "FXAA"
        }
      ]
    },
    {
      "key": "render_msaa",
      "type": "choice",
      "title": {
        "en": "MSAA",
        "ru": "MSAA"
      },
      "default": "0",
      "choices": [
        {
          "value": "0",
          "title": {
            "en": "Off",
            "ru": "Выключено"
          }
        },
        {
          "value": "2",
          "title": "2×"
        },
        {
          "value": "4",
          "title": "4×"
        }
      ]
    },
    {
      "key": "render_upscaler",
      "type": "choice",
      "title": {
        "en": "Render upscaling",
        "ru": "Апскейлинг рендера"
      },
      "default": "0",
      "choices": [
        {
          "value": "0",
          "title": {
            "en": "Bilinear",
            "ru": "Билинейный"
          }
        },
        {
          "value": "1",
          "title": "FSR 1"
        }
      ]
    }
  ]
}
